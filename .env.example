# Required
GEMINI_API_KEY=

# Model with JSON schema / structured output support
GEMINI_MODEL=gemini-2.5-flash

# Optional: USD per 1M tokens (override if Google changes list prices)
GEMINI_INPUT_USD_PER_1M=0.15
GEMINI_OUTPUT_USD_PER_1M=0.60

# Crawl budgets
MAX_PAGES_PER_DOMAIN=8
MAX_CHARS_PER_PAGE=12000
PAGE_TIMEOUT_MS=45000
REQUEST_RETRIES=2

# Google Search grounding for missing leadership LinkedIn URLs
ENABLE_LINKEDIN_SEARCH=true
